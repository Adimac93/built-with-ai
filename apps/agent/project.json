{
  "name": "agent",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/agent/src",
  "projectType": "application",
  "tags": ["agent", "rust"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/Cargo.toml",
        "{projectRoot}/Cargo.lock",
        "{projectRoot}/triz.json"
      ],
      "outputs": ["{projectRoot}/target/release/agent"],
      "options": {
        "command": "cargo build --release",
        "cwd": "apps/agent"
      }
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run",
        "cwd": "apps/agent"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/Cargo.toml",
        "{projectRoot}/Cargo.lock",
        "{projectRoot}/triz.json"
      ],
      "options": {
        "command": "cargo test",
        "cwd": "apps/agent"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/Cargo.toml",
        "{projectRoot}/Cargo.lock",
        "{projectRoot}/triz.json"
      ],
      "options": {
        "command": "cargo clippy --all-targets -- -D warnings",
        "cwd": "apps/agent"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash tools/deploy-agent.sh"
      }
    }
  }
}
