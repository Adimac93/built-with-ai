# Local development configuration
# For deployment, these are set via Terraform / `just deploy-agent`.

# Vertex AI (default): OAuth token comes from GOOGLE_CLOUD_ACCESS_TOKEN if set,
# otherwise from the GCP metadata server (Cloud Run service account).
GOOGLE_CLOUD_PROJECT=built-with-ai-gdg-wroclaw
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for the Gemini API via Google AI Studio,
# set an API key (takes precedence over Vertex):
# GEMINI_API_KEY=your-api-key-here

# Comma-separated CORS allow-list (unset = CORS disabled, same as FastAPI setup)
# ALLOW_ORIGINS=http://localhost:4200

# Log filter (tracing EnvFilter syntax); default info.
# Structured Cloud Logging JSON is emitted automatically on Cloud Run.
# RUST_LOG=info,agent=debug
