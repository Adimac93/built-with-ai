{
  "$schema": "https://tokens.studio/schemas/tokens.json",
  "meta": {
    "name": "Heureka Design System",
    "source": "apps/frontend/src/design-system/tokens.scss",
    "wcagTarget": "WCAG 2.1 AA",
    "tokenModel": ["primitive", "semantic", "contextual"]
  },
  "primitive": {
    "color": {
      "sage": {
        "50": { "value": "#fafbf6", "type": "color" },
        "100": { "value": "#f1f4ec", "type": "color" },
        "200": { "value": "#d6decb", "type": "color" },
        "500": { "value": "#8f9c8c", "type": "color" },
        "700": { "value": "#5a685a", "type": "color" },
        "950": { "value": "#1b2b21", "type": "color" }
      },
      "red": {
        "100": { "value": "#f6e8e4", "type": "color" },
        "200": { "value": "#f2b8ad", "type": "color" },
        "600": { "value": "#c93a26", "type": "color" }
      },
      "amber": {
        "300": { "value": "#f5d97a", "type": "color" },
        "700": { "value": "#b07d1a", "type": "color" }
      }
    },
    "font": {
      "family": {
        "body": { "value": "'IBM Plex Sans', sans-serif", "type": "fontFamilies" },
        "display": { "value": "'Big Shoulders Display', sans-serif", "type": "fontFamilies" },
        "code": { "value": "'IBM Plex Mono', monospace", "type": "fontFamilies" },
        "admin": { "value": "Roboto, 'Helvetica Neue', sans-serif", "type": "fontFamilies" }
      }
    },
    "space": {
      "300": { "value": "8px", "type": "spacing" },
      "600": { "value": "16px", "type": "spacing" },
      "900": { "value": "24px", "type": "spacing" },
      "1400": { "value": "64px", "type": "spacing" }
    },
    "radius": {
      "md": { "value": "10px", "type": "borderRadius" },
      "lg": { "value": "14px", "type": "borderRadius" },
      "pill": { "value": "999px", "type": "borderRadius" }
    }
  },
  "semantic": {
    "color": {
      "background": {
        "canvas": { "value": "{primitive.color.sage.100}", "type": "color" },
        "card": { "value": "{primitive.color.sage.50}", "type": "color" },
        "selected": { "value": "{primitive.color.sage.950}", "type": "color" }
      },
      "content": {
        "primary": { "value": "{primitive.color.sage.950}", "type": "color" },
        "secondary": { "value": "{primitive.color.sage.700}", "type": "color" },
        "inverse": { "value": "{primitive.color.sage.50}", "type": "color" }
      },
      "border": {
        "strong": { "value": "{primitive.color.sage.950}", "type": "color" },
        "muted": { "value": "{primitive.color.sage.500}", "type": "color" }
      },
      "accent": {
        "danger": { "value": "{primitive.color.red.600}", "type": "color" }
      }
    }
  },
  "contextual": {
    "button": {
      "primary": {
        "background": { "value": "{semantic.color.background.selected}", "type": "color" },
        "content": { "value": "{semantic.color.content.inverse}", "type": "color" },
        "hoverBackground": { "value": "{semantic.color.accent.danger}", "type": "color" }
      }
    },
    "form": {
      "focusRing": { "value": "{semantic.color.accent.danger}", "type": "color" },
      "errorContent": { "value": "{semantic.color.accent.danger}", "type": "color" }
    },
    "sheet": {
      "grid": { "value": "{primitive.color.sage.200}", "type": "color" },
      "background": { "value": "{semantic.color.background.card}", "type": "color" }
    },
    "diagram": {
      "activeBorder": { "value": "{primitive.color.amber.700}", "type": "color" },
      "activeBackground": { "value": "{primitive.color.amber.300}", "type": "color" }
    }
  }
}
