{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/frontend/src",
  "tags": ["app", "rust"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/assets/**/*",
        "{projectRoot}/public/**/*",
        "{projectRoot}/Cargo.toml",
        "{projectRoot}/Cargo.lock",
        "{projectRoot}/Dioxus.toml"
      ],
      "outputs": ["{projectRoot}/dist/web"],
      "options": {
        "command": "bash tools/build-frontend.sh"
      }
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "\"${DX_BIN:-$HOME/.cargo/bin/dx}\" serve",
        "cwd": "apps/frontend"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/Cargo.toml",
        "{projectRoot}/Cargo.lock"
      ],
      "options": {
        "command": "cargo test",
        "cwd": "apps/frontend"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/Cargo.toml",
        "{projectRoot}/Cargo.lock"
      ],
      "options": {
        "command": "cargo clippy --target wasm32-unknown-unknown -- -D warnings",
        "cwd": "apps/frontend"
      }
    },
    "deploy": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build --platform linux/amd64 -t gcr.io/built-with-ai-gdg-wroclaw/frontend -f apps/frontend/Dockerfile . && docker push gcr.io/built-with-ai-gdg-wroclaw/frontend && gcloud run deploy frontend --image gcr.io/built-with-ai-gdg-wroclaw/frontend --platform managed --region us-central1 --allow-unauthenticated --project built-with-ai-gdg-wroclaw"
      }
    }
  }
}
